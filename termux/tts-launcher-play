#!/data/data/com.termux/files/usr/bin/python
"""Read text from stdin, synthesize Edge neural speech, play temporary chunks.

Dedicated to Termux TTS Launcher. Never reads the Android clipboard and never
modifies the user's existing `tts` command or audio downloads.
"""

from __future__ import annotations

import asyncio
import concurrent.futures
import fcntl
import importlib.util
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time
import uuid

# Lazy import: stop-only invocation should not initialize Edge TTS.
edge_tts = None

VOICE = "ru-RU-DmitryNeural"
MAX_INPUT_BYTES = 96 * 1024
FIRST_CHUNK = 155
LATER_CHUNK = 650
WORKERS = 2
ATTEMPTS = 3
MEDIA_TIMEOUT = 12
POLL_SECONDS = 0.4
STATE_DIR = Path.home() / ".cache" / "termux-tts-launcher"
ACTIVE_FILE = STATE_DIR / "active"
LOCK_FILE = STATE_DIR / "active.lock"
AUDIO_PREFIX = "tts-launcher-"
TIMING_FILE = STATE_DIR / "last-timing.txt"


def normalize(text: str) -> str:
    text = (text or "").replace("\u00a0", " ").replace("\r", "")
    text = re.sub(r"[ \t]+", " ", text)
    text = re.sub(r"\n[ \t]+", "\n", text)
    return re.sub(r"\n{3,}", "\n\n", text).strip()


def split_chunks(text: str, first: int = FIRST_CHUNK, later: int = LATER_CHUNK) -> list[str]:
    """Sentence/word oriented splitting with no removed or duplicated words."""
    text = normalize(text)
    if not text:
        return []
    chunks: list[str] = []
    remaining = text
    while remaining:
        limit = first if not chunks else later
        if len(remaining) <= limit:
            chunks.append(remaining)
            break
        portion = remaining[:limit + 1]
        # Prefer sentence and then word boundaries, avoiding tiny fragments.
        boundaries = [m.end() for m in re.finditer(r"[.!?…][\"'»)]*\s+|\n+", portion)]
        candidates = [pos for pos in boundaries if int(limit * 0.4) <= pos <= limit]
        if candidates:
            cut = candidates[-1]
        else:
            spaces = [m.start() for m in re.finditer(r"\s+", portion)]
            usable = [pos for pos in spaces if int(limit * 0.4) <= pos <= limit]
            cut = usable[-1] if usable else limit
        chunks.append(remaining[:cut].strip())
        remaining = remaining[cut:].lstrip()
    return [chunk for chunk in chunks if chunk]


def command(args: list[str], timeout: int = MEDIA_TIMEOUT) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, capture_output=True, text=True, timeout=timeout, check=False)


def media_info() -> str:
    result = command(["termux-media-player", "info"])
    return result.stdout.strip() if result.returncode == 0 else ""


def owned_track(info: str, run_id: str | None = None) -> bool:
    name = re.search(r"^Track:\s*(\S+)", info, flags=re.MULTILINE)
    if not name:
        return False
    return Path(name.group(1)).name.startswith(AUDIO_PREFIX + (run_id or ""))


def stop_owned(run_id: str | None = None) -> None:
    try:
        if owned_track(media_info(), run_id):
            command(["termux-media-player", "stop"])
    except (OSError, subprocess.TimeoutExpired):
        pass


def active_session() -> tuple[str, int | None] | None:
    """Read the active token and PID; old token-only installations still work."""
    try:
        fields = ACTIVE_FILE.read_text(encoding="ascii").split()
    except OSError:
        return None
    if not fields:
        return None
    try:
        pid = int(fields[1]) if len(fields) > 1 else None
    except ValueError:
        pid = None
    return fields[0], pid


def pid_running(pid: int | None) -> bool:
    if pid is None:
        return True
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def toggle_session(run_id: str) -> bool:
    """First tap starts; second tap cancels the currently active run."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("a+") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        try:
            previous = active_session()
            if previous is not None:
                old_id, pid = previous
                ACTIVE_FILE.unlink(missing_ok=True)
                # Never stop a track belonging to another app.
                stop_owned(old_id)
                if pid_running(pid):
                    return False
            ACTIVE_FILE.write_text(f"{run_id} {os.getpid()}\n", encoding="ascii")
            return True
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)


def still_active(run_id: str) -> bool:
    try:
        return (active_session() or (None, None))[0] == run_id
    except OSError:
        return False


def clear_if_active(run_id: str) -> None:
    with LOCK_FILE.open("a+") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        if still_active(run_id):
            ACTIVE_FILE.unlink(missing_ok=True)
        fcntl.flock(handle, fcntl.LOCK_UN)


def synthesize(chunk: str, dest: Path, run_id: str) -> Path:
    """Call edge-tts as a library, avoiding a CLI process for each fragment."""
    error = ""
    for attempt in range(ATTEMPTS):
        if not still_active(run_id):
            raise RuntimeError("Playback replaced by another request")
        try:
            global edge_tts
            if edge_tts is None:
                import edge_tts as edge_tts_module
                edge_tts = edge_tts_module
            asyncio.run(edge_tts.Communicate(chunk, voice=VOICE).save(str(dest)))
            if dest.exists() and dest.stat().st_size:
                return dest
            error = "edge-tts returned no audio"
        except Exception as exc:
            error = str(exc)[-300:]
        dest.unlink(missing_ok=True)
        if attempt < ATTEMPTS - 1:
            if not still_active(run_id):
                raise RuntimeError("Playback replaced by another request")
            time.sleep(1 + attempt)
    raise RuntimeError(f"Microsoft Edge TTS: {error}")


def play_file(path: Path, run_id: str, on_started=None) -> None:
    # The stop tap must not race a new audio segment into playback.
    with LOCK_FILE.open("a+") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        try:
            if not still_active(run_id):
                return
            started = command(["termux-media-player", "play", str(path)])
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)
    if started.returncode != 0 or not started.stdout.startswith("Now Playing:"):
        raise RuntimeError(f"Media playback failed: {(started.stderr or started.stdout).strip()}")
    if on_started is not None:
        on_started()
    saw_owned = False
    no_status_count = 0
    deadline = time.monotonic() + 20 * 60
    while time.monotonic() < deadline:
        if not still_active(run_id):
            stop_owned(run_id)
            return
        info = media_info()
        if not info:
            no_status_count += 1
            if no_status_count >= 4:
                raise RuntimeError("Termux:API media player is unavailable")
        else:
            no_status_count = 0
        if owned_track(info, run_id):
            saw_owned = True
        elif "No track currently" in info:
            if saw_owned:
                return
            time.sleep(0.2)
            if "No track currently" in media_info():
                raise RuntimeError("Audio player stopped before playback")
        elif info and "Track:" in info:
            raise RuntimeError("Audio was interrupted by another player")
        time.sleep(POLL_SECONDS)
    raise RuntimeError("Playback timed out")


def record_first_play(run_id: str, started: float, claimed: float,
                      ready: float, play_ack: float, count: int) -> None:
    """Timings only; never write the clipboard text or audio."""
    report = (
        f"segments={count}\n"
        f"startup_claim_ms={round((claimed - started) * 1000)}\n"
        f"first_audio_ready_ms={round((ready - started) * 1000)}\n"
        f"first_play_request_ms={round((play_ack - started) * 1000)}\n"
        f"player_command_ms={round((play_ack - ready) * 1000)}\n"
    )
    try:
        with LOCK_FILE.open("a+") as handle:
            fcntl.flock(handle, fcntl.LOCK_EX)
            if still_active(run_id):
                TIMING_FILE.write_text(report, encoding="utf-8")
            fcntl.flock(handle, fcntl.LOCK_UN)
    except OSError:
        pass


def run(text: str) -> int:
    started = time.monotonic()
    run_id = uuid.uuid4().hex[:16]
    if not toggle_session(run_id):
        # A second tap is STOP, including while speech is still synthesizing.
        return 0
    claimed = time.monotonic()
    if importlib.util.find_spec("edge_tts") is None and edge_tts is None:
        print("Missing edge-tts Python library; run install-launcher.sh", file=sys.stderr)
        clear_if_active(run_id)
        return 2
    if shutil.which("termux-media-player") is None:
        print("Missing termux-media-player; run install-launcher.sh", file=sys.stderr)
        clear_if_active(run_id)
        return 2
    parts = split_chunks(text)
    if not parts:
        print("No text received", file=sys.stderr)
        clear_if_active(run_id)
        return 1
    with tempfile.TemporaryDirectory(prefix="tts-launcher-") as temp:
        folder = Path(temp)
        with concurrent.futures.ThreadPoolExecutor(max_workers=WORKERS) as pool:
            futures: dict[int, concurrent.futures.Future[Path]] = {}
            def submit(index: int) -> None:
                path = folder / f"{AUDIO_PREFIX}{run_id}-{index:04d}.mp3"
                futures[index] = pool.submit(synthesize, parts[index], path, run_id)
            try:
                for i in range(min(WORKERS, len(parts))):
                    submit(i)
                for i in range(len(parts)):
                    if not still_active(run_id):
                        break
                    file_path = futures.pop(i).result()
                    if i + WORKERS < len(parts):
                        submit(i + WORKERS)
                    if i == 0:
                        ready = time.monotonic()
                        def first_started() -> None:
                            record_first_play(run_id, started, claimed, ready,
                                              time.monotonic(), len(parts))
                        play_file(file_path, run_id, on_started=first_started)
                    else:
                        play_file(file_path, run_id)
                    file_path.unlink(missing_ok=True)
            finally:
                stop_owned(run_id)
                clear_if_active(run_id)
    return 0


def main() -> int:
    # The content arrives via RUN_COMMAND_STDIN and is never persisted as text.
    raw = sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
    if len(raw) > MAX_INPUT_BYTES:
        print("Text exceeds 96 KiB limit", file=sys.stderr)
        return 2
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        print("Input must be UTF-8", file=sys.stderr)
        return 2
    try:
        return run(text)
    except Exception as exc:
        print(f"TTS launcher error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
